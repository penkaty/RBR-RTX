#usda 1.0
(
    upAxis = "Y"
)

def Xform "RootNode"
{
    def Scope "Looks"
    {
        # BMW M3 E30 GrpA rear-view + left mirror glass
        def Material "mat_42F245929F784ABE"
        {
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                asset inputs:diffuse_texture = @./textures/white.dds@ (
                    colorSpace = "auto"
                )
                color3f inputs:diffuse_color_constant = (0.9, 0.9, 0.9)
                float inputs:metallic_constant = 1
                float inputs:reflection_roughness_constant = 0
                token outputs:out
            }
        }
        # exhaust pop (backfire) sprite g_pop.dds
        def Material "mat_93E4994710A5380B"
        {
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                bool inputs:use_legacy_alpha_state = 0
                bool inputs:blend_enabled = 1
                int inputs:blend_type = 1
                bool inputs:enable_emission = 1
                color3f inputs:emissive_color_constant = (1, 0.55, 0.2)
                float inputs:emissive_intensity = 4
                token outputs:out
            }
        }
    }
}
